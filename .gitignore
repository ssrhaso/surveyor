# This repository tracks code, configuration and pre-registration documents.
# Everything below is produced by that code, downloaded by it, or is narrative
# about it, and stays local.

# Python
__pycache__/
*.py[cod]
.venv*/
*.egg-info/

# Checkpoints, datasets and encoded latents. Reproducible from the training and
# build entry points in the README, and over GitHub's per-file limit.
*.pt
*.h5
*.npz
*.episodes*.json
data/
runs/
encoder_reacher/
encoder_tworoom/
vjepa2/upstream/

# Cluster job scripts: thin SLURM wrappers around the commands the README
# documents, carrying site-specific accounts, paths and queue names.
batch/
*.sbatch

# Experiment outputs: logs, per-run JSON, mined CSVs, rendered rollouts.
Results/
strips/
cld/
archive/

# Manuscript sources, figures and build artifacts. The code tree stands alone.
paper/
writeup/
*.tex
*.pdf
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz

# Working notes, superseded by the manuscript and by prereg/.
PLAN.md
DIRECTION_*.md
RESULTS_*.md
docs/
