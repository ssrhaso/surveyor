# This repository tracks code, configuration, the fixed evaluation populations (episodes/), the tolerance-probe
# outputs (calibration/) and the pipeline that rebuilds the paper's tables and figures from the harvested results
# (reproduce/). Pre-registration documents are not part of it. Everything below is produced by that code, downloaded
# by it, or is narrative about it, and stays local.

# Python
__pycache__/
*.py[cod]
.venv*/
*.egg-info/

# Checkpoints, datasets and encoded latents. Reproducible from the training and
# build entry points in the README, and over GitHub's per-file limit.
*.pt
*.h5
*.npz
*.episodes*.json
/data/
/runs/
/encoder_reacher/
/encoder_tworoom/
/vjepa2/upstream/
# local copies of the evaluation populations; the tracked ones are in episodes/
/*.json

# Cluster job scripts: thin SLURM wrappers around the commands the README
# documents, carrying site-specific accounts, paths and queue names.
/batch/
*.sbatch

# Experiment outputs: logs, per-run JSON, mined CSVs, rendered rollouts.
/Results/
/strips/
/cld/
/archive/
/logs/

# Manuscript sources, figures and build artifacts. The code tree stands alone.
/paper/
/writeup/
*.tex
*.pdf
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk

# Working notes and pre-registration documents, not released.
PLAN.md
DIRECTION_*.md
RESULTS_*.md
/prereg/
/docs/*
!/docs/media/
!/docs/media/*

# Editor and script backups, kept out of the re-included media directory.
*.bak
*.bak-*
*.bak_*

# Development drivers that no reported result uses.
/surveyor/proj_oracle.py
/surveyor/envs/*/eval_proj.py

# External code is cloned at the pinned commits of external/README.md, not vendored.
/external/*
!/external/README.md

# V-JEPA 2 scratch: the upstream clone, its job wrappers and encoded latents.
/vjepa2/

# The reproducibility package, re-included after the patterns above (episode files match *.episodes*.json, the array
# runner matches *.sbatch); the builders' default output directory stays local.
!/episodes/*.json
!/calibration/*.json
!/reproduce/*.sbatch
/reproduce/out/
